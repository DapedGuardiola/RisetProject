{
  "name": "microservices",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^1.0.0-rc.4",
    "prettier": "^3.7.4",
    "tsx": "^4.23.12",
    "turbo": "^2.10.10",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.16.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@clickhouse/client": "^1.23.1",
    "@faker-js/faker": "^10.6.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/microservices": "^11.2.1",
    "drizzle-orm": "1.0.0-rc.3",
    "pg": "^8.23.0"
  }
}
